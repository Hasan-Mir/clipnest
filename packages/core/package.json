{
    "name": "@seymi/clipnest-core",
    "version": "0.2.0",
    "description": "ClipNest Core — Native Rust engine (N-API .node addon + IPC client + SQLite/transforms) shared by ClipNest GUI and CLI.",
    "license": "MIT",
    "author": "SeyMi",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "scripts"
    ],
    "scripts": {
        "build": "tsc",
        "build:native": "bun run scripts/build-native.ts",
        "typecheck": "tsc --noEmit --skipLibCheck",
        "typecheck:bun": "bun check --skipLibCheck && bun check --skipLibCheck scripts/build-native.ts"
    },
    "devDependencies": {
        "@types/node": "^22.10.0"
    }
}
