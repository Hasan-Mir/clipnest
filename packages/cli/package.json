{
    "name": "@seymi/clipnest-cli",
    "version": "0.2.0",
    "description": "ClipNest CLI — Fast, pipeline-friendly command-line interface and automation tool for the ClipNest clipboard manager (clipnest / clipn).",
    "keywords": [
        "clipnest",
        "clipn",
        "clipboard",
        "clipboard-manager",
        "copyq",
        "cli",
        "automation",
        "windows",
        "tauri"
    ],
    "license": "MIT",
    "author": "SeyMi",
    "maintainers": [
        "SeyMi"
    ],
    "type": "module",
    "bin": {
        "clipnest": "dist/index.js",
        "clipn": "dist/index.js"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "bin",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit --skipLibCheck",
        "typecheck:bun": "bun check --skipLibCheck && bun check --skipLibCheck tests/run-cli.test.ts",
        "test": "bun test tests/run-cli.test.ts",
        "prepublishOnly": "npm run build",
        "postinstall": "node -e \"const fs=require('node:fs');if(fs.existsSync('dist/install-binary.js'))import('./dist/install-binary.js')\"",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "@seymi/clipnest-core": "0.2.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.0"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Hasan-Mir/clipnest.git"
    },
    "bugs": {
        "url": "https://github.com/Hasan-Mir/clipnest/issues"
    },
    "homepage": "https://github.com/Hasan-Mir/clipnest#readme"
}
