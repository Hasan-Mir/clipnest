{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"],
        "paths": {
            "@seymi/clipnest-core": ["../core/dist/index.d.ts", "../core/src/index.ts"]
        }
    },
    "include": ["src"]
}
