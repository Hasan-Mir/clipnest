{
    "name": "clipnest",
    "private": true,
    "version": "0.2.0",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build && npm run build:cli",
        "build:cli": "npm run build --workspace @seymi/clipnest-cli",
        "typecheck": "tsc --noEmit && npm run typecheck --workspace @seymi/clipnest-cli",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
        "test:all": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
        "format": "prettier --write \"**/*.{ts,tsx,css,json}\" && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
        "format:check": "prettier --check \"**/*.{ts,tsx,css,json}\" && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
        "prepare": "husky",
        "tauri": "tauri dev",
        "tauri:build": "tauri build && cargo build --release --manifest-path src-tauri/Cargo.toml --bin clipnest-cli && node scripts/build-portable.mjs",
        "tauri:portable": "tauri build --no-bundle && cargo build --release --manifest-path src-tauri/Cargo.toml --bin clipnest-cli && node scripts/build-portable.mjs"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.8.0",
        "@floating-ui/react": "^0.27.2",
        "@tauri-apps/api": "^2.12.4",
        "lucide-react": "^1.61.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "virtua": "^0.53.6"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12.4",
        "@types/node": "^22.10.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "lint-staged": {
        "*.{ts,tsx,css,json}": [
            "prettier --write"
        ],
        "src-tauri/**/*.rs": [
            "cargo fmt --manifest-path src-tauri/Cargo.toml --all --"
        ]
    }
}
