{
    "name": "clipnest",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md,ts}\" && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,md,ts}\" && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
        "prepare": "husky",
        "tauri": "tauri dev"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.12.4",
        "lucide-react": "^1.61.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "virtua": "^0.53.6"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12.4",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "lint-staged": {
        "*.{ts,tsx,css,json,md}": [
            "prettier --write"
        ],
        "src-tauri/**/*.rs": [
            "cargo fmt --manifest-path src-tauri/Cargo.toml --all --"
        ]
    }
}
